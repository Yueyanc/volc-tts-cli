{
  "name": "volc-tts-cli",
  "version": "0.3.0",
  "description": "A small CLI for Volcengine / Doubao text-to-speech HTTP synthesis.",
  "type": "module",
  "bin": {
    "volc-tts": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "check": "node --check src/cli.js",
